{
  "name": "norea",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare": "node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-channel.mjs",
    "android:apk:release": "tauri android build --apk --split-per-abi --target aarch64 --target x86_64",
    "windows:bundle:release": "pnpm windows:bundle:x86_64 && pnpm windows:bundle:arm64",
    "windows:bundle:x86_64": "pnpm tauri build --target x86_64-pc-windows-msvc --bundles nsis,msi",
    "windows:bundle:arm64": "pnpm tauri build --target aarch64-pc-windows-msvc --bundles nsis,msi",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@mantine/notifications": "^9.7.4",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "cheerio": "^1.2.0",
    "css-tree": "^3.2.1",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.4",
    "htmlparser2": "^12.0.0",
    "marked": "^18.1.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.28.2"
    }
  }
}
