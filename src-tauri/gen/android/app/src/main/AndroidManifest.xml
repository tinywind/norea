<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".NoreaApplication"
        android:allowBackup="false"
        android:icon="${appIcon}"
        android:roundIcon="${appRoundIcon}"
        android:label="${appName}"
        android:theme="@style/Theme.app"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="${appName}"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
            <intent-filter >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="norea" />
                <data android:host="repo" />
                
                
                <data android:pathPrefix="/add" />
                
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
            <!-- tauri-file-associations. AUTO-GENERATED. DO NOT REMOVE. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/plain" />
                <data android:pathPattern=".*\\.txt" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/markdown" />
                <data android:pathPattern=".*\\.md" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
                <data android:pathPattern=".*\\.pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/epub+zip" />
                <data android:pathPattern=".*\\.epub" />
            </intent-filter>

            <!-- tauri-file-associations. AUTO-GENERATED. DO NOT REMOVE. -->
        </activity>

        <service
            android:name=".TaskForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- specialUse has no daily runtime quota; downloads need the dataSync quota. -->
        <service
            android:name=".PluginVpnForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the in-app VPN tunnel used for plugin traffic connected while the app is in the background." />
        </service>

        <service android:name=".AndroidVpnDownloadWorker0Service"
            android:exported="false" android:process=":vpn_download_0" />
        <service android:name=".AndroidVpnDownloadWorker1Service"
            android:exported="false" android:process=":vpn_download_1" />
        <service android:name=".AndroidVpnDownloadWorker2Service"
            android:exported="false" android:process=":vpn_download_2" />
        <service android:name=".AndroidVpnDownloadWorker3Service"
            android:exported="false" android:process=":vpn_download_3" />
        <service android:name=".AndroidVpnDownloadWorker4Service"
            android:exported="false" android:process=":vpn_download_4" />
        <service android:name=".AndroidVpnDownloadWorker5Service"
            android:exported="false" android:process=":vpn_download_5" />
        <service android:name=".AndroidVpnDownloadWorker6Service"
            android:exported="false" android:process=":vpn_download_6" />
        <service android:name=".AndroidVpnDownloadWorker7Service"
            android:exported="false" android:process=":vpn_download_7" />
        <service android:name=".AndroidVpnDownloadWorker8Service"
            android:exported="false" android:process=":vpn_download_8" />
        <service android:name=".AndroidVpnDownloadWorker9Service"
            android:exported="false" android:process=":vpn_download_9" />
        <activity android:name=".AndroidVpnDownloadWorker0Activity"
            android:exported="false" android:process=":vpn_download_0"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:excludeFromRecents="true" />
        <activity android:name=".AndroidVpnDownloadWorker1Activity"
            android:exported="false" android:process=":vpn_download_1"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:excludeFromRecents="true" />
        <activity android:name=".AndroidVpnDownloadWorker2Activity"
            android:exported="false" android:process=":vpn_download_2"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:excludeFromRecents="true" />
        <activity android:name=".AndroidVpnDownloadWorker3Activity"
            android:exported="false" android:process=":vpn_download_3"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:excludeFromRecents="true" />
        <activity android:name=".AndroidVpnDownloadWorker4Activity"
            android:exported="false" android:process=":vpn_download_4"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:excludeFromRecents="true" />
        <activity android:name=".AndroidVpnDownloadWorker5Activity"
            android:exported="false" android:process=":vpn_download_5"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:excludeFromRecents="true" />
        <activity android:name=".AndroidVpnDownloadWorker6Activity"
            android:exported="false" android:process=":vpn_download_6"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:excludeFromRecents="true" />
        <activity android:name=".AndroidVpnDownloadWorker7Activity"
            android:exported="false" android:process=":vpn_download_7"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:excludeFromRecents="true" />
        <activity android:name=".AndroidVpnDownloadWorker8Activity"
            android:exported="false" android:process=":vpn_download_8"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:excludeFromRecents="true" />
        <activity android:name=".AndroidVpnDownloadWorker9Activity"
            android:exported="false" android:process=":vpn_download_9"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:excludeFromRecents="true" />

        <receiver
            android:name=".TaskNotificationActionReceiver"
            android:exported="false" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
